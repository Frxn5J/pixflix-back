; Pixflix API - PHP-FPM pool tuned for a 2 GB RAM server
; Drop into /etc/php/8.2/fpm/pool.d/www.conf
;
; Budget: OS+nginx ~500 MB, OPcache ~192 MB (shared), leaving ~1.3 GB
; for workers. A loaded Laravel 10 worker sits around 30-50 MB RSS.
; Measure yours with:  ps -o rss= -C php-fpm8.2 | awk '{s+=$1} END {print s/NR/1024 " MB"}'

[www]
user = www-data
group = www-data
listen = /run/php/php8.2-fpm.sock
listen.owner = www-data
listen.group = www-data

; --- Process manager ---------------------------------------------------------
; static + a fixed pool behaves predictably under burst load.
pm = static
; ~35 MB/worker -> 1.3 GB / 35 MB = ~36. Keep headroom: 30.
; With PIXFLIX_STREAM_DELIVERY=xaccel streams do NOT hold workers, so 30
; workers only serve API JSON + manifest rewrites (fast requests).
pm.max_children = 30
pm.start_servers = 8
pm.min_spare_servers = 4
pm.max_spare_servers = 12

; Recycle workers to bound memory leaks from long-running processes.
pm.max_requests = 2000

; Watchdog: kills requests stuck longer than 120s (PHP-FPM sends 504).
; Matches fastcgi_read_timeout in the nginx example.
request_terminate_timeout = 120s

; Slow log to spot heavy endpoints (catalog sync triggered via HTTP, etc.)
slowlog = /var/log/php8.2-fpm-slow.log
request_slowlog_timeout = 5s
