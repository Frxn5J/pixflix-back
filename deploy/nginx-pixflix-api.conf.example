# Pixflix API - nginx + PHP-FPM
#
# Optimized for high concurrency on small servers:
#  - gzip for JSON payloads.
#  - API timeouts stay short because media is not streamed by Laravel.

server {
    listen 80;
    listen [::]:80;
    server_name api.ejemplo.com;

    root /var/www/pixflix-backend/public;
    index index.php;

    # --- JSON compression -----------------------------------------------------
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types application/json application/vnd.apple.mpegurl application/x-mpegURL;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;

        # API requests are fast; anything longer is a bug or a stuck sync.
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
