APP_NAME=Pixflix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_TIMEZONE=UTC
APP_LOCALE=es-419
APP_FALLBACK_LOCALE=es-419
APP_FAKER_LOCALE=es_MX

PIXFLIX_SERVICE_NAME=pixflix-api
PIXFLIX_RATE_LIMIT_PER_MINUTE=60
PIXFLIX_AUTH_TOKEN_NAME=pwa
PIXFLIX_PWA_FORCE_UPDATE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000,::1
PIXFLIX_CATALOG_PRIMARY_URL=https://zonaapis.arcando.cloud
PIXFLIX_CATALOG_FALLBACK_URL=https://apiprorescue.testaacc.workers.dev
PIXFLIX_CATALOG_VERIFY_SSL=true
PIXFLIX_TMDB_API_KEY=
PIXFLIX_TMDB_ACCESS_TOKEN=
PIXFLIX_TMDB_LANGUAGE=es-MX
PIXFLIX_TMDB_TIMEOUT_SECONDS=8
PIXFLIX_TMDB_VERIFY_SSL=true
PIXFLIX_IPTV_M3U_URL=https://iptv-org.github.io/iptv/index.m3u
# Déjalo vacío para importar todos los países, o usa un código ISO como MX.
PIXFLIX_IPTV_COUNTRY=
PIXFLIX_IPTV_MAX_CHANNELS=
PIXFLIX_IPTV_TIMEOUT_SECONDS=30
PIXFLIX_IPTV_VERIFY_SSL=true
PIXFLIX_IPTV_SYNC_CRON=03:30
PIXFLIX_SYNC_CRON_HOUR=04:00
PIXFLIX_SYNC_TIMEZONE=UTC
PIXFLIX_SYNC_ALLOW_ON_DEMAND=false
PIXFLIX_TRIAL_PLAN_ID=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE is intentionally omitted so Laravel uses database/database.sqlite.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
