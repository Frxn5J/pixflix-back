APP_NAME=Pixflix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_TIMEZONE=UTC
APP_LOCALE=es-419
APP_FALLBACK_LOCALE=es-419
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

PIXFLIX_SERVICE_NAME=pixflix-api
PIXFLIX_RATE_LIMIT_PER_MINUTE=60
PIXFLIX_RATE_LIMIT_AUTH_PER_MINUTE=240
PIXFLIX_AUTH_TOKEN_NAME=pwa
ADMIN_EMAIL=admin@pixflix.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE
PIXFLIX_PWA_FORCE_UPDATE=false
# Stream delivery: 'php' streams through PHP-FPM (default, works anywhere);
# 'xaccel' frees PHP workers and lets nginx stream (requires the internal
# location in deploy/nginx-pixflix-api.conf.example).
PIXFLIX_STREAM_DELIVERY=php
PIXFLIX_STREAM_ACCEL_LOCATION=/internal/upstream
# External stream proxy (Cloudflare Worker, deploy/cloudflare/): when set,
# raw media bytes (HLS segments, MP4, live TS) are served by the Worker and
# NOT by this server; manifests still pass through the backend for rewriting.
# The secret must match the Worker's PIXFLIX_STREAM_SECRET.
PIXFLIX_STREAM_PROXY_BASE_URL=
PIXFLIX_STREAM_PROXY_SECRET=
# API cache lifetime in seconds (0 disables). Sync stamps invalidate it early
# whenever the catalog or IPTV channel data changes.
PIXFLIX_CACHE_CATALOG_TTL=43200
PIXFLIX_CACHE_CHANNELS_TTL=43200
# Automatic cache warmup: use 12 or 24 hours.
PIXFLIX_CACHE_WARMUP_INTERVAL_HOURS=12
# Production uses Dragonfly for distributed cache, sessions, locks and queues.
# Laravel calls its Redis-compatible driver "redis"; the server is Dragonfly.
QUEUE_CONNECTION=redis
DRAGONFLY_CLIENT=phpredis
DRAGONFLY_URL=
DRAGONFLY_HOST=127.0.0.1
DRAGONFLY_PORT=6379
DRAGONFLY_USERNAME=
DRAGONFLY_PASSWORD=null
DRAGONFLY_DB=0
DRAGONFLY_CACHE_DB=1
DRAGONFLY_READ_TIMEOUT=60
DRAGONFLY_CONNECT_TIMEOUT=5
DRAGONFLY_RETRY_INTERVAL=100
DRAGONFLY_QUEUE=default
QUEUE_RETRY_AFTER=3600
QUEUE_BLOCK_FOR=5
PIXFLIX_SYNC_ASYNC=true
# The Docker/Coolify entrypoint enqueues this once; the queue worker warms the
# hot API responses in the background. Use --force to repeat it manually.
RUN_CACHE_WARMUP=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000,::1
PIXFLIX_CATALOG_PRIMARY_URL=https://zonaapis.arcando.cloud
PIXFLIX_CATALOG_FALLBACK_URL=https://apiprorescue.testaacc.workers.dev
PIXFLIX_CATALOG_VERIFY_SSL=true
PIXFLIX_TMDB_API_KEY=
PIXFLIX_TMDB_ACCESS_TOKEN=
PIXFLIX_TMDB_LANGUAGE=es-MX
PIXFLIX_TMDB_TIMEOUT_SECONDS=8
PIXFLIX_TMDB_VERIFY_SSL=true
PIXFLIX_IPTV_M3U_URL=https://iptv-org.github.io/iptv/index.m3u
# Déjalo vacío para importar todos los países, o usa un código ISO como MX.
PIXFLIX_IPTV_COUNTRY=
PIXFLIX_IPTV_MAX_CHANNELS=
PIXFLIX_IPTV_TIMEOUT_SECONDS=30
PIXFLIX_IPTV_VERIFY_SSL=true
PIXFLIX_SYNC_CRON_HOUR=04:00
PIXFLIX_SYNC_TIMEZONE=UTC
PIXFLIX_SYNC_ALLOW_ON_DEMAND=false
PIXFLIX_TRIAL_PLAN_ID=

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
# Coolify can provide DATABASE_URL. DB_URL is also accepted.
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pixflix
DB_USERNAME=pixflix
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

BROADCAST_DRIVER=null
CACHE_STORE=redis
FILESYSTEM_DISK=local
SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
